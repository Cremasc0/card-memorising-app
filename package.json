{
  "name": "trevisane-card-drill",
  "version": "1.1.0",
  "private": true,
  "description": "Windows desktop card counting drill with selectable poker and Trevisane card styles",
  "main": "main.cjs",
  "scripts": {
    "prevectorize:cards": "python prepare_trace.py",
    "vectorize:cards": "node vectorize_cards.js",
    "start": "electron .",
    "build:win": "electron-builder --win portable",
    "build:mac": "electron-builder --mac dmg zip --universal"
  },
  "dependencies": {
    "imagetracerjs": "^1.2.6",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.cardmemorising.drill",
    "productName": "Card Counting Drill",
    "asar": true,
    "files": [
      "main.cjs",
      "app/**/*",
      "Single Cards (One Per FIle)/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/card-drill-icon.ico"
    },
    "mac": {
      "icon": "build/card-drill-icon.icns",
      "category": "public.app-category.education"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "portable": {
      "artifactName": "Card-Counting-Drill-${version}.exe"
    },
    "directories": {
      "output": "dist"
    }
  }
}
